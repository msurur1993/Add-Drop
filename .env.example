# Core app
SECRET_KEY=change-me
DATABASE_URL=sqlite:///addrop.db
PEOPLESOFT_URL=https://coursesearch92.ais.uchicago.edu/
CURRENT_TERM=2264
CHECK_INTERVAL=50
PLAYWRIGHT_HEADLESS=true

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if your deployed callback URL differs from Flask's _external value
GOOGLE_OAUTH_REDIRECT_URI=

# App email delivery
# Recommended: resend
EMAIL_PROVIDER=resend
EMAIL_FROM=alerts@example.com
EMAIL_REPLY_TO=support@example.com
RESEND_API_KEY=

# Alternative: smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional legacy fallback: gmail_api
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Local development fallback only
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_ENABLE_INTERACTIVE_AUTH=false
